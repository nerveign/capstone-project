# Salin file ini menjadi `.env`, lalu isi nilainya. `.env` tidak boleh di-commit.
# Di hosting (Render, dll.), isi variable yang sama lewat dashboard platform.

# Google Apps Script / Google Sheets (RAHASIA)
GAS_URL=
GAS_API_KEY=

# MQTT client (mqtt_client.py)
# Alamat broker: samakan dengan yang dipakai ESP32 (lihat kode ESP32).
MQTT_BROKER=localhost
MQTT_PORT=1883
# Topik tempat ESP32 mempublikasikan data
MQTT_TOPIC=spm/sdp14/data
# Login broker (RAHASIA). Kosongkan jika broker tidak memakai login.
MQTT_USERNAME=
MQTT_PASSWORD=
# Alamat Flask yang menerima data dari client ini
FLASK_URL=http://127.0.0.1:5000/api/mqtt-data
